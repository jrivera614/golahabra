---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
---
<Base title="Advertise" description="Reach La Habra locals with a featured listing or a sponsorship in the Thursday Drop newsletter.">
  <section class="wrap section">
    <div class="kicker">Advertise</div>
    <h1 class="disp h-xl head">Get in front of your neighbors.</h1>
    <p class="lede">Go La Habra reaches people who live five minutes from your door. No national ad networks, no pop-ups. Just local businesses, shown to local people.</p>

    <div class="cards">
      <div class="card">
        <h2 class="disp">Featured listing</h2>
        <p>Top placement on the Eat List or in your category, with photos and a link to order or book.</p>
      </div>
      <div class="card">
        <h2 class="disp">Thursday Drop sponsor</h2>
        <p>Your business at the top of the weekly email that goes straight to La Habra inboxes.</p>
      </div>
      <div class="card">
        <h2 class="disp">Event spotlight</h2>
        <p>Promote an opening, a special, or an event across the site, the newsletter, and our socials.</p>
      </div>
    </div>

    <div class="note">
      <p><strong>One rule:</strong> sponsors never buy a spot in our rankings or a good review. Ads are always labeled.</p>
      <a href={`mailto:${SITE.email}?subject=Advertising`} class="btn">Email us about rates</a>
    </div>
  </section>
</Base>

<style>
  .head { margin-top: 10px; max-width: 900px; }
  .lede { margin: 20px 0 0; max-width: 640px; font-size: 20px; color: var(--ink-2); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-top: 40px; }
  .card { padding: 24px; border: 1px solid var(--line); border-radius: var(--radius); }
  .card h2 { font-size: 24px; }
  .card p { margin: 10px 0 0; color: var(--ink-2); }
  .note { margin-top: 40px; display: flex; flex-wrap: wrap; align-items: center; gap: 20px; padding: 24px; border-radius: var(--radius); background: var(--soft); }
  .note p { margin: 0; flex: 1 1 360px; font-size: 17px; }
</style>
