---
import Base from '../layouts/Base.astro';
import EventRow from '../components/EventRow.astro';
import { getUpcomingEvents, SITE } from '../lib/site';
const events = await getUpcomingEvents();
---
<Base title="Events" description="What's happening in La Habra this week and beyond: festivals, community events, and things to do with the kids.">
  <section class="wrap section">
    <div class="section-head">
      <div>
        <div class="kicker">Events</div>
        <h1 class="disp h-xl">Coming up in La Habra</h1>
        <p>Festivals, parks, the museum, and whatever else is going on around town.</p>
      </div>
    </div>
    <div class="list">
      {events.length > 0 ? (
        events.map((e) => <EventRow event={e} />)
      ) : (
        <p class="empty"><strong>Nothing on the calendar yet.</strong> Know about something? <a href={`mailto:${SITE.email}?subject=Event`}>Send it in.</a></p>
      )}
    </div>
    <p class="suggest">Running an event in La Habra? <a href={`mailto:${SITE.email}?subject=Event`}>Send us the details</a> and we'll add it.</p>
  </section>
</Base>

<style>
  .list { max-width: 820px; }
  .suggest { margin-top: 40px; font-size: 17px; color: var(--ink-2); }
  .suggest a, .empty a { color: var(--accent); text-decoration: underline; }
</style>
