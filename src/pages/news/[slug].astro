---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { getNews, fmtDate, SITE } from '../../lib/site';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: d.title,
  description: d.dek,
  datePublished: d.date.toISOString(),
  author: { '@type': 'Person', name: d.author },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};
if (d.image) jsonLd.image = new URL(d.image, Astro.site).href;
---
<Base title={d.title} description={d.dek} type="article" image={d.image}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="wrap section">
    <header class="head">
      <a href="/news/" class="kicker">{d.category}</a>
      <h1 class="disp h-lg">{d.title}</h1>
      <p class="dek">{d.dek}</p>
      <p class="muted byline">By {d.author} · <time datetime={d.date.toISOString()}>{fmtDate(d.date, { month: 'long', day: 'numeric', year: 'numeric' })}</time>{d.draft && ' · Draft'}</p>
    </header>
    {d.image && <img class="hero-img" src={d.image} alt={d.imageAlt ?? ''} width="1200" height="675" />}
    <div class="prose">
      <Content />
    </div>
    <aside class="signup">
      <NewsletterForm id="post-email" label="Get stories like this every Thursday" />
    </aside>
  </article>
</Base>

<style>
  .head { max-width: 820px; display: flex; flex-direction: column; gap: 14px; margin-bottom: 32px; }
  .dek { margin: 0; font-size: 21px; color: var(--ink-2); }
  .byline { margin: 0; font-size: 15px; }
  .hero-img { width: 100%; max-width: 900px; height: auto; border-radius: var(--radius); margin-bottom: 32px; }
  .signup { margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--line); max-width: 680px; }
</style>
